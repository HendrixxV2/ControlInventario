{
  "name": "control-inventario",
  "version": "1.0.0",
  "private": true,
  "main": "backend/src/server.js",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run migrate && npm run seed && nodemon backend/src/server.js",
    "dev:frontend": "vite --config vite.config.js --host 127.0.0.1",
    "build": "vite --config vite.config.js build",
    "lint": "eslint frontend/src backend/src",
    "start": "node backend/src/server.js",
    "migrate": "node backend/src/db/migrate.js",
    "seed": "node backend/src/db/seed.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.10.0",
    "node-cron": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vite": "^6.0.1"
  }
}
